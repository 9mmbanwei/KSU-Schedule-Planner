# Copy this file to .env and fill in what you need. Never put .env on GitHub.

# Turns on "Describe your week" and "Advisor notes". Get a key at console.anthropic.com.
# Leave it empty and the planner still works, just without the AI features.
ANTHROPIC_API_KEY=

# Which KSU term to download (YYYY01 = Spring, YYYY05 = Summer, YYYY08 = Fall)
KSU_TERM=202701

# How often to re-download class data, in hours. 0 = never (use what's in data/).
REFRESH_HOURS=24

# Optional
# KSU_BASE_URL=https://srs-owlexpress.kennesaw.edu/StudentRegistrationSsb/ssb
# KSU_SUBJECTS=CS CSE MATH ...      (defaults to every subject the four majors use)
# KSU_DELAY=1.0                     (seconds between requests to KSU; be polite)
# AI_PER_HOUR=20                    (AI requests allowed per visitor per hour)
# MODEL_QUICK=claude-haiku-5-5
# MODEL_ADVISOR=claude-sonnet-5-5
